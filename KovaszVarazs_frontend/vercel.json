{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist/kovasz-varazs-frontend/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://kovaszvarazs-backend-bhsorj.laravel.cloud/api/$1"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
